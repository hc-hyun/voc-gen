{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.internal/schema/internal-dev-test-result-v0.2.json",
  "title": "Internal development test result v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "test_result_id",
    "record_type",
    "report_text",
    "provenance_type",
    "language",
    "dataset_split",
    "tested_at",
    "product",
    "device_model_context",
    "test_execution",
    "findings"
  ],
  "properties": {
    "test_result_id": {
      "type": "string",
      "minLength": 1
    },
    "record_type": {
      "const": "INTERNAL_DEV_TEST_RESULT"
    },
    "report_text": {
      "type": "string",
      "minLength": 1
    },
    "provenance_type": {
      "enum": [
        "REAL_INTERNAL",
        "SYNTHETIC_SCENARIO",
        "HUMAN_AUTHORED_TEST"
      ]
    },
    "synthetic_parent_case_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^IDT-[0-9]{4,}$"
      }
    },
    "language": {
      "enum": [
        "KO",
        "EN",
        "KO_EN_MIXED"
      ]
    },
    "dataset_split": {
      "enum": [
        "TRAIN",
        "VALID",
        "TEST"
      ]
    },
    "tested_at": {
      "type": "string",
      "format": "date-time"
    },
    "product": {
      "$ref": "#/$defs/product"
    },
    "device_model_context": {
      "$ref": "#/$defs/deviceModelContext"
    },
    "test_execution": {
      "$ref": "#/$defs/testExecution"
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/finding"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "provenance_type": {
            "const": "SYNTHETIC_SCENARIO"
          }
        },
        "required": [
          "provenance_type"
        ]
      },
      "then": {
        "required": [
          "synthetic_parent_case_ids"
        ]
      }
    }
  ],
  "$defs": {
    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_type",
        "product_family",
        "model_name",
        "model_code",
        "software_build"
      ],
      "properties": {
        "product_type": {
          "type": "string",
          "minLength": 1
        },
        "product_family": {
          "type": "string",
          "minLength": 1
        },
        "model_name": {
          "$ref": "#/$defs/nullableString"
        },
        "model_code": {
          "$ref": "#/$defs/nullableString"
        },
        "software_build": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "deviceModelContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_family",
        "representative_model_name",
        "representative_model_name_ko",
        "project_code",
        "project_name",
        "project_evidence",
        "context_role"
      ],
      "properties": {
        "model_family": {
          "type": "string",
          "pattern": "^SM-[A-Z][0-9]{3}$"
        },
        "representative_model_name": {
          "type": "string",
          "minLength": 1
        },
        "representative_model_name_ko": {
          "type": "string",
          "minLength": 1
        },
        "project_code": {
          "type": "string",
          "minLength": 1
        },
        "project_name": {
          "$ref": "#/$defs/nullableString"
        },
        "project_evidence": {
          "enum": [
            "official_trace",
            "public_report"
          ]
        },
        "context_role": {
          "enum": [
            "PRIMARY_DUT",
            "COMPANION_PHONE"
          ]
        }
      }
    },
    "testExecution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validator_role",
        "execution_mode",
        "environment",
        "user_case"
      ],
      "properties": {
        "validator_role": {
          "type": "string",
          "minLength": 1
        },
        "execution_mode": {
          "enum": [
            "MANUAL",
            "AUTOMATED",
            "HYBRID"
          ]
        },
        "environment": {
          "$ref": "#/$defs/environment"
        },
        "user_case": {
          "$ref": "#/$defs/userCase"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os_version",
        "app_version",
        "network",
        "locale",
        "additional_attributes"
      ],
      "properties": {
        "os_version": {
          "$ref": "#/$defs/nullableString"
        },
        "app_version": {
          "$ref": "#/$defs/nullableString"
        },
        "network": {
          "$ref": "#/$defs/nullableString"
        },
        "locale": {
          "$ref": "#/$defs/nullableString"
        },
        "additional_attributes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "userCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user_case_id",
        "title",
        "actor",
        "goal",
        "trigger",
        "success_outcome",
        "preconditions"
      ],
      "properties": {
        "user_case_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "trigger": {
          "type": "string",
          "minLength": 1
        },
        "success_outcome": {
          "type": "string",
          "minLength": 1
        },
        "preconditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "title",
        "severity",
        "problem_symptom",
        "cause_analysis",
        "countermeasures",
        "resolution_status",
        "evidence_spans"
      ],
      "properties": {
        "finding_id": {
          "type": "string",
          "pattern": "^F[0-9]{2,}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "BLOCKER",
            "CRITICAL",
            "MAJOR",
            "MINOR",
            "TRIVIAL"
          ]
        },
        "problem_symptom": {
          "$ref": "#/$defs/problemSymptom"
        },
        "cause_analysis": {
          "$ref": "#/$defs/causeAnalysis"
        },
        "countermeasures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/countermeasure"
          }
        },
        "resolution_status": {
          "enum": [
            "OPEN",
            "IN_ANALYSIS",
            "FIX_PLANNED",
            "FIXED",
            "VERIFIED",
            "CLOSED"
          ]
        },
        "evidence_spans": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidenceSpan"
          },
          "contains": {
            "type": "object",
            "properties": {
              "field": {
                "const": "PROBLEM_SYMPTOM"
              }
            },
            "required": [
              "field"
            ]
          }
        }
      }
    },
    "problemSymptom": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "occurrence_description",
        "occurrence_context",
        "expected_behavior",
        "actual_behavior",
        "reproduction_path"
      ],
      "properties": {
        "occurrence_description": {
          "type": "string",
          "minLength": 1
        },
        "occurrence_context": {
          "type": "string",
          "minLength": 1
        },
        "expected_behavior": {
          "type": "string",
          "minLength": 1
        },
        "actual_behavior": {
          "type": "string",
          "minLength": 1
        },
        "reproduction_path": {
          "$ref": "#/$defs/reproductionPath"
        }
      }
    },
    "reproductionPath": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preconditions",
        "steps",
        "observed_at_step",
        "reproducibility"
      ],
      "properties": {
        "preconditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/reproductionStep"
          }
        },
        "observed_at_step": {
          "type": "integer",
          "minimum": 1
        },
        "reproducibility": {
          "enum": [
            "ALWAYS",
            "FREQUENT",
            "INTERMITTENT",
            "RARE",
            "ONCE",
            "NOT_RETESTED"
          ]
        }
      }
    },
    "reproductionStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_no",
        "action",
        "expected_result",
        "actual_result"
      ],
      "properties": {
        "step_no": {
          "type": "integer",
          "minimum": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "expected_result": {
          "$ref": "#/$defs/nullableString"
        },
        "actual_result": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "causeAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "description",
        "suspected_component",
        "evidence"
      ],
      "properties": {
        "status": {
          "enum": [
            "UNKNOWN",
            "HYPOTHESIS",
            "LIKELY",
            "CONFIRMED"
          ]
        },
        "description": {
          "$ref": "#/$defs/nullableString"
        },
        "suspected_component": {
          "$ref": "#/$defs/nullableString"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "CONFIRMED"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "description": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "countermeasure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measure_id",
        "measure_type",
        "status",
        "description",
        "target_release",
        "verification"
      ],
      "properties": {
        "measure_id": {
          "type": "string",
          "pattern": "^M[0-9]{2,}$"
        },
        "measure_type": {
          "enum": [
            "WORKAROUND",
            "CODE_FIX",
            "CONFIG_CHANGE",
            "TEST_ADDITION",
            "DOCUMENTATION",
            "MONITORING",
            "PREVENTION"
          ]
        },
        "status": {
          "enum": [
            "PROPOSED",
            "PLANNED",
            "IN_PROGRESS",
            "IMPLEMENTED",
            "VERIFIED",
            "REJECTED"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "target_release": {
          "$ref": "#/$defs/nullableString"
        },
        "verification": {
          "$ref": "#/$defs/verification"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "VERIFIED"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "verification": {
                "properties": {
                  "method": {
                    "type": "string",
                    "minLength": 1
                  },
                  "result": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      ]
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "result"
      ],
      "properties": {
        "method": {
          "$ref": "#/$defs/nullableString"
        },
        "result": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "evidenceSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "quote",
        "start",
        "end",
        "occurrence"
      ],
      "properties": {
        "field": {
          "enum": [
            "PROBLEM_SYMPTOM",
            "CAUSE_ANALYSIS",
            "COUNTERMEASURE"
          ]
        },
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        },
        "occurrence": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
